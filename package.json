{
  "name": "@react-ui-org/eslint-config",
  "description": "Shareable ESLint config for JavaScript, TypeScript and React projects.",
  "version": "1.1.0",
  "keywords": [
    "eslint",
    "eslintconfig",
    "config",
    "javascript",
    "typescript",
    "react",
    "styleguide",
    "react-ui"
  ],
  "homepage": "https://github.com/react-ui-org/eslint-config",
  "author": "The React UI Authors (https://github.com/react-ui-org/eslint-config/graphs/contributors)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/react-ui-org/eslint-config/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/react-ui-org/eslint-config"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.3 || ^26.13.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.19.1",
      "onFail": "error"
    }
  },
  "scripts": {
    "inspect": "npx --yes @eslint/config-inspector --config inspect.config.mjs",
    "lint": "npm run lint:eslint && npm run lint:markdownlint",
    "lint:eslint": "eslint",
    "lint:eslint:fix": "eslint --fix",
    "lint:markdownlint": "markdownlint-cli2"
  },
  "dependencies": {
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "eslint": "^9.22.0",
    "typescript": ">=5.0.0 <6.1.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "markdownlint-cli2": "^0.23.3",
    "typescript": "~6.0.3"
  }
}
